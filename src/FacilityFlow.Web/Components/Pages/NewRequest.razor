@page "/neu"
@rendermode InteractiveServer
@inject FacilityFlowApiClient Api
@inject NavigationManager Navigation
<PageTitle>Neue Anfrage | FacilityFlow</PageTitle>
<h1>Neue Serviceanfrage</h1><p class="lead">Erfassen Sie eine technische Störung mit den wichtigsten Angaben.</p>
<div class="panel form-panel"><EditForm Model="model" OnValidSubmit="Save"><DataAnnotationsValidator/><div class="form-grid"><label>Titel<input @bind="model.Title" maxlength="150" required/></label><label>Kategorie<InputSelect @bind-Value="model.Category">@foreach(var x in Enum.GetValues<ServiceCategory>()){<option value="@x">@Display(x)</option>}</InputSelect></label><label>Priorität<InputSelect @bind-Value="model.Priority">@foreach(var x in Enum.GetValues<Priority>()){<option value="@x">@x</option>}</InputSelect></label><label>Gebäude<select @bind="model.BuildingId"><option value="">Bitte auswählen</option>@foreach(var b in buildings){<option value="@b.Id">@b.Name</option>}</select></label><label class="wide">Beschreibung<textarea @bind="model.Description" rows="6" maxlength="4000" required></textarea></label><label>Techniker (optional)<input @bind="model.AssignedTechnician" placeholder="z. B. Anna Becker"/></label><label>Fällig am<input type="date" @bind="dueDate"/></label></div>@if(!string.IsNullOrEmpty(error)){<p class="error">@error</p>}<div class="actions"><a class="button secondary" href="/serviceanfragen">Abbrechen</a><button class="button" type="submit" disabled="@saving">@(saving?"Wird gespeichert …":"Anfrage speichern")</button></div></EditForm></div>
@code{private readonly FormModel model=new();private IReadOnlyList<BuildingDto> buildings=[];private DateTime dueDate=DateTime.Today.AddDays(3);private bool saving;private string? error;protected override async Task OnInitializedAsync(){buildings=await Api.GetBuildingsAsync();if(buildings.Count>0)model.BuildingId=buildings[0].Id;}private async Task Save(){try{saving=true;error=null;await Api.CreateAsync(new(model.Title,model.Description,model.Category,model.Priority,model.BuildingId,null,model.AssignedTechnician,dueDate.ToUniversalTime()));Navigation.NavigateTo("/serviceanfragen");}catch(Exception ex){error=ex.Message;}finally{saving=false;}}private static string Display(ServiceCategory x)=>x switch{ServiceCategory.Sanitaer=>"Sanitär",ServiceCategory.Gebaeudetechnik=>"Gebäudetechnik",ServiceCategory.Moebel=>"Möbel",_=>x.ToString()};private sealed class FormModel{public string Title{get;set;}="";public string Description{get;set;}="";public ServiceCategory Category{get;set;}=ServiceCategory.IT;public Priority Priority{get;set;}=Priority.Mittel;public Guid BuildingId{get;set;}public string? AssignedTechnician{get;set;}}}
